{
  "schemaVersion": "orchestration-roadmap/v1",
  "repository": "todd-skelton/orchestration-platform",
  "milestones": [
    {
      "key": "M1",
      "title": "Portable foundation",
      "description": "Outcome: the repository has an executable TypeScript toolchain and the same configuration, contract, filesystem, lock, process, and CLI guarantees are proven on current macOS, Windows, and Linux. Scope boundary: no orchestration kernel, self-promotion, or consumer mutation. Entry gates: none. Exit evidence: trusted three-OS harness receipts plus the portable capability and primitive conformance matrices."
    },
    {
      "key": "M2",
      "title": "Self-hosting release",
      "description": "Outcome: independently authorized bootstrap N0 uses the released platform, concrete worker host, independent review, final OS certification, and promotion protocol to produce and activate N1. Scope boundary: no external-consumer authority transfer. Entry gates: none; preparatory slices may run when their own blocked-by edges clear. Activation gate: ISS-019 requires Portable foundation exit evidence before N0 authorization. Exit evidence: N0 bootstrap receipt, joined N0-to-N1 journal, exact-candidate review and promotion receipts, negative controls, and a healthy next routine N1 cycle."
    },
    {
      "key": "M3",
      "title": "First consumer adoption",
      "description": "Outcome: the selected external repository pins the platform, supplies its policy through an adapter, proves authoritative shadow parity, and transfers control with tested recovery. Scope boundary: no second consumer or general marketplace. Entry gates: none; parity-fixture preparation may run when its own blocked-by edges clear. Activation gate: ISS-017 cannot begin live shadow or cutover work until the self-hosting release dependencies clear. Exit evidence: parity fixture coverage, terminal shadow report, cutover/recovery receipts, and the seven-day post-cutover observation report."
    }
  ],
