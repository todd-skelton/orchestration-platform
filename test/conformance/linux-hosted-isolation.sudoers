Defaults:node !requiretty
node ALL=(root) NOPASSWD: /usr/bin/python3.11 /authority/linux-principal-account.py *
node ALL=(root) NOPASSWD: /usr/bin/python3.11 -I -B /authority/linux-principal-dac.py
node ALL=(root) NOPASSWD: /usr/bin/python3.11 -I -B /authority/linux-pidfd-quiesce.py *
node ALL=(root) CWD=* NOPASSWD: /usr/bin/setpriv --reuid * --regid * --clear-groups --no-new-privs --inh-caps=-all --ambient-caps=-all --bounding-set=-all /usr/bin/env -i ../node ../rpc-runner.mjs ./candidate.mjs --linux-principal * *
