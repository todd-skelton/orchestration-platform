{
  "schemaVersion": "reference-authority-inventory/v1",
  "authorities": [
    {
      "id": "authority-filesystem",
      "kind": "host-state",
      "requiredObservation": "observation-path-confinement"
    },
    {
      "id": "authority-process-table",
      "kind": "host-state",
      "requiredObservation": "observation-exact-process-identity"
    },
    {
      "id": "authority-version-control",
      "kind": "repository-state",
      "requiredObservation": "observation-exact-revision-and-cleanliness"
    },
    {
      "id": "authority-code-host",
      "kind": "external-control-plane",
      "requiredObservation": "observation-fresh-external-subject"
    },
    {
      "id": "authority-event-journal",
      "kind": "durable-state",
      "requiredObservation": "observation-current-journal-generation"
    },
    {
      "id": "authority-test-fixture",
      "kind": "synthetic-only",
      "requiredObservation": "observation-fixture-confinement"
    }
  ],
  "observations": [
    { "id": "observation-path-confinement", "unavailableDisposition": "refuse-write" },
    {
      "id": "observation-exact-process-identity",
      "unavailableDisposition": "capacity-indeterminate"
    },
    {
      "id": "observation-exact-revision-and-cleanliness",
      "unavailableDisposition": "refuse-repository-mutation"
    },
    {
      "id": "observation-fresh-external-subject",
      "unavailableDisposition": "external-unavailable"
    },
    {
      "id": "observation-current-journal-generation",
      "unavailableDisposition": "refuse-append"
    },
    { "id": "observation-fixture-confinement", "unavailableDisposition": "refuse-fixture" }
  ]
}
