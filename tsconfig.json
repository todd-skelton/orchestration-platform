{
  "extends": "./tsconfig.base.json",
  "include": [
    "packages/*/src/**/*.ts",
    "probes/*/src/**/*.ts",
    "adapters/*/src/**/*.ts",
    "fixtures/*/src/**/*.ts",
    "fixtures/*/test/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": ["**/dist/**", "modules/.generated/**", "**/build/**", "node_modules"]
}
