{
  "name": "orchestration-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "format": "node scripts/format.mjs write",
    "format:check": "node scripts/format.mjs check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "verify:bootstrap": "node scripts/verify/bootstrap.mjs",
    "planning:check": "node scripts/planning/check.mjs",
    "planning:board-check": "node scripts/planning/board-check.mjs",
    "loop:supervise": "node scripts/dogfood/supervise.mjs"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
